# Copy to .streamlit/secrets.toml (never commit the real file), or paste into
# Streamlit Cloud -> App settings -> Secrets.

# Required: password for the admin console (Sign in -> Admin tab).
ADMIN_PASSWORD = "change-me-to-a-long-random-password"

# Recommended: public URL of the app, used on certificates and as the payment return URL.
APP_URL = "https://academy.eintrusts.com"

# Optional: Razorpay keys enable online checkout for paid courses.
# Without them, paid courses accept enrollment requests that an admin approves.
# RAZORPAY_KEY_ID = "rzp_live_xxxxxxxx"
# RAZORPAY_KEY_SECRET = "xxxxxxxx"

# Optional: where the SQLite database is stored (default: academy.db).
# ACADEMY_DB_PATH = "/data/academy.db"
